<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Norbert's Journal | Healing Path</title>
  <meta name="description" content="Gentle updates from Norbert's healing journey. Written by Mama Sue as Norbert walks through his healing path.">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Norbert Barkah">
  <meta property="og:title" content="Norbert's Journal | Healing Path">
  <meta property="og:description" content="Gentle updates from Norbert's healing journey. Written by Mama Sue as Norbert walks through his healing path.">
  <meta property="og:image" content="https://norbertbarkah.com/images/norbert-social-preview.jpg">
  <meta property="og:url" content="https://journal.norbertbarkah.com">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Norbert's Journal | Healing Path">
  <meta name="twitter:description" content="Gentle updates from Norbert's healing journey.">
  <meta name="twitter:image" content="https://norbertbarkah.com/images/norbert-social-preview.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    /* ============================================================
       CSS CUSTOM PROPERTIES -- Norbert site palette
    ============================================================ */
    :root {
      --forest-deep:    #2C4A3E;
      --forest-mid:     #3a6352;
      --gold:           #C4A35A;
      --gold-soft:      rgba(196, 163, 90, 0.35);
      --cream:          #FAF6F0;
      --cream-dark:     #f0ece4;
      --sage:           #7A9E8E;
      --text-dark:      #2a2a2a;
      --text-mid:       #4a4a4a;
      --font-display:   'Cormorant Garamond', serif;
      --font-body:      'Nunito', sans-serif;
      --nav-height:     68px;
      --sidebar-width:  240px;
    }

    /* ============================================================
       RESET + BASE
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--cream);
      color: var(--text-dark);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    /* ============================================================
       HEADER / NAV
    ============================================================ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(250, 246, 240, 0.96);
      border-bottom: 1px solid rgba(196, 163, 90, 0.18);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      height: var(--nav-height);
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--forest-deep);
      font-weight: 600;
    }

    .header-brand span {
      color: var(--gold);
    }

    .header-back {
      font-family: var(--font-body);
      font-size: 0.82rem;
      color: var(--sage);
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.2s;
    }

    .header-back:hover { color: var(--forest-deep); }

    .header-back svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ============================================================
       HERO
    ============================================================ */
    .journal-hero {
      padding-top: var(--nav-height);
      background: var(--forest-deep);
      background-image:
        linear-gradient(160deg, rgba(30,51,41,0.95) 0%, rgba(44,74,62,0.90) 60%, rgba(58,99,82,0.88) 100%),
        url('https://norbertbarkah.com/images/enchanted-forest-hero.jpg');
      background-size: cover;
      background-position: center;
      text-align: center;
      padding-bottom: 3.5rem;
    }

    .journal-hero-content {
      max-width: 680px;
      margin: 0 auto;
      padding: 3.5rem 2rem 0;
    }

    .hero-eyebrow {
      font-family: var(--font-body);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
      opacity: 0.85;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 600;
      color: var(--cream);
      line-height: 1.15;
      margin-bottom: 1.25rem;
      text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    }

    .hero-subtitle {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.15rem;
      color: rgba(250, 246, 240, 0.78);
      line-height: 1.75;
      margin-bottom: 2rem;
    }

    .hero-rule {
      border: none;
      border-top: 1px solid rgba(196, 163, 90, 0.35);
      width: 60px;
      margin: 0 auto;
    }

    /* ============================================================
       MAIN LAYOUT
    ============================================================ */
    .journal-body {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3.5rem 2rem 5rem;
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      gap: 3.5rem;
      align-items: start;
    }

    /* ============================================================
       SIDEBAR
    ============================================================ */
    .journal-sidebar {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
    }

    .sidebar-label {
      font-family: var(--font-body);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.1rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--gold-soft);
    }

    .sidebar-list {
      list-style: none;
    }

    .sidebar-list li {
      margin-bottom: 0.1rem;
    }

    .sidebar-item-btn {
      display: block;
      width: 100%;
      background: none;
      border: none;
      border-left: 2px solid transparent;
      padding: 0.65rem 0.85rem;
      cursor: pointer;
      text-align: left;
      transition: border-color 0.2s, background 0.2s;
      border-radius: 0 8px 8px 0;
    }

    .sidebar-item-btn:hover {
      background: rgba(44, 74, 62, 0.05);
      border-left-color: var(--gold-soft);
    }

    .sidebar-item-btn.active {
      background: rgba(196, 163, 90, 0.08);
      border-left-color: var(--gold);
    }

    .sidebar-item-date {
      display: block;
      font-family: var(--font-body);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.2rem;
    }

    .sidebar-item-title {
      display: block;
      font-family: var(--font-display);
      font-size: 0.98rem;
      color: var(--forest-deep);
      line-height: 1.35;
    }

    .sidebar-item-btn.active .sidebar-item-title {
      color: var(--forest-mid);
      font-weight: 600;
    }

    /* ============================================================
       MAIN READING AREA
    ============================================================ */
    .journal-main {
      min-height: 400px;
    }

    /* Status messages */
    .journal-status {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.2rem;
      color: var(--sage);
      text-align: center;
      padding: 4rem 2rem;
      line-height: 1.7;
    }

    /* Entry card */
    .journal-entry {
      background: #ffffff;
      border-radius: 20px;
      padding: 3rem 3.5rem;
      box-shadow: 0 4px 32px rgba(44, 74, 62, 0.07), 0 1px 4px rgba(44,74,62,0.04);
      border-top: 3px solid var(--gold);
      animation: entry-fade-in 0.4s ease both;
    }

    @keyframes entry-fade-in {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .entry-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .entry-date-badge {
      font-family: var(--font-body);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      background: rgba(196, 163, 90, 0.08);
      border: 1px solid var(--gold-soft);
      padding: 0.3rem 0.85rem;
      border-radius: 20px;
    }

    .entry-title {
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 3vw, 2.2rem);
      font-weight: 600;
      color: var(--forest-deep);
      line-height: 1.25;
      margin-bottom: 1.75rem;
    }

    .entry-divider {
      border: none;
      border-top: 1px solid rgba(196, 163, 90, 0.2);
      margin-bottom: 1.75rem;
      width: 60px;
    }

    .entry-body p {
      font-family: var(--font-body);
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--text-mid);
      margin-bottom: 1.15rem;
    }

    .entry-body p:last-child {
      margin-bottom: 0;
    }

    /* ============================================================
       MOBILE COLLAPSIBLE TOGGLE
    ============================================================ */
    .mobile-toggle-wrap {
      display: none;
      margin-bottom: 2rem;
    }

    .mobile-toggle-btn {
      width: 100%;
      background: var(--forest-deep);
      color: var(--cream);
      border: none;
      font-family: var(--font-body);
      font-size: 0.9rem;
      letter-spacing: 0.04em;
      padding: 0.85rem 1.5rem;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      transition: background 0.2s;
    }

    .mobile-toggle-btn:hover { background: var(--forest-mid); }

    .mobile-toggle-icon {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      transition: transform 0.25s;
    }

    .mobile-toggle-btn[aria-expanded="true"] .mobile-toggle-icon {
      transform: rotate(180deg);
    }

    .mobile-entry-list {
      display: none;
      list-style: none;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(44,74,62,0.08);
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .mobile-entry-list.open {
      display: block;
    }

    .mobile-entry-list li {
      border-bottom: 1px solid rgba(196, 163, 90, 0.1);
    }

    .mobile-entry-list li:last-child {
      border-bottom: none;
    }

    .mobile-entry-btn {
      display: block;
      width: 100%;
      background: none;
      border: none;
      padding: 0.9rem 1.25rem;
      cursor: pointer;
      text-align: left;
      transition: background 0.15s;
    }

    .mobile-entry-btn:hover { background: rgba(44,74,62,0.04); }

    .mobile-entry-btn.active { background: rgba(196, 163, 90, 0.07); }

    .mobile-entry-date {
      display: block;
      font-family: var(--font-body);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.15rem;
    }

    .mobile-entry-title {
      display: block;
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--forest-deep);
      line-height: 1.3;
    }

    /* ============================================================
       FOOTER
    ============================================================ */
    .site-footer {
      background: var(--forest-deep);
      text-align: center;
      padding: 2.5rem 2rem;
    }

    .footer-brand {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: rgba(250, 246, 240, 0.7);
      margin-bottom: 0.5rem;
    }

    .footer-brand span { color: var(--gold); }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      font-family: var(--font-body);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      color: rgba(250, 246, 240, 0.5);
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--gold); }

    .footer-copy {
      font-family: var(--font-body);
      font-size: 0.75rem;
      color: rgba(250, 246, 240, 0.3);
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @media (max-width: 900px) {
      .journal-body {
        grid-template-columns: 1fr;
        gap: 0;
        padding: 2rem 1.5rem 4rem;
      }
      .journal-sidebar {
        display: none;
      }
      .mobile-toggle-wrap {
        display: block;
      }
    }

    @media (max-width: 600px) {
      .journal-entry {
        padding: 2rem 1.5rem;
      }
      .hero-title {
        font-size: 2rem;
      }
    }
  </style>
</head>
<body>

  <!-- ====== HEADER ====== -->
  <header class="site-header">
    <div class="header-inner">
      <div class="header-brand">
        Norbert <span>Barkah</span>
      </div>
      <a href="https://norbertbarkah.com" class="header-back">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        Back to main site
      </a>
    </div>
  </header>

  <!-- ====== HERO ====== -->
  <section class="journal-hero">
    <div class="journal-hero-content">
      <p class="hero-eyebrow">A healing path through the forest</p>
      <h1 class="hero-title">Norbert's Journal</h1>
      <p class="hero-subtitle">Written by Mama Sue as Norbert walks through his healing journey, one brave pawstep at a time.</p>
      <hr class="hero-rule">
    </div>
  </section>

  <!-- ====== BODY: SIDEBAR + ENTRIES ====== -->
  <main class="journal-body" id="journal-body">

    <!-- Desktop sidebar -->
    <aside class="journal-sidebar" aria-label="Journal entry list">
      <p class="sidebar-label">All entries</p>
      <ul class="sidebar-list" id="sidebar-list"></ul>
    </aside>

    <!-- Main reading area -->
    <div class="journal-main" id="journal-main">

      <!-- Mobile collapsible entry list -->
      <div class="mobile-toggle-wrap">
        <button class="mobile-toggle-btn" id="mobile-toggle-btn" aria-expanded="false" aria-controls="mobile-entry-list">
          <span>All entries</span>
          <svg class="mobile-toggle-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <ul class="mobile-entry-list" id="mobile-entry-list" aria-hidden="true"></ul>
      </div>

      <!-- Entry display area -->
      <div id="entry-display">
        <p class="journal-status" id="journal-status">Loading Norbert's journal...</p>
      </div>

    </div>
  </main>

  <!-- ====== FOOTER ====== -->
  <footer class="site-footer">
    <p class="footer-brand">Norbert <span>Barkah</span></p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="https://norbertbarkah.com">Main Site</a>
      <a href="https://norbertbarkah.com/books.html">The Book</a>
      <a href="https://norbertbarkah.com/storytime.html">Storytime</a>
      <a href="https://norbertbarkah.com/contact.html">Contact</a>
    </nav>
    <p class="footer-copy">&copy; 2026 Norbert Barkah. All rights reserved.</p>
  </footer>

  <!-- ====== JOURNAL JAVASCRIPT ====== -->
  <!--
    All API-provided content (title, date, body, id) is rendered using
    document.createElement() and textContent only.
    innerHTML is used only for fixed hardcoded strings that Claude controls.
    No API text is ever passed to innerHTML.
  -->
  <script>
    var API_URL = "https://tracker.norbertbarkah.com/api/journal";
    var allEntries = [];

    // Format YYYY-MM-DD to "May 13, 2026"
    function formatDate(raw) {
      if (!raw) return "";
      var parts = raw.split("-");
      if (parts.length !== 3) return raw;
      var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
      if (isNaN(d.getTime())) return raw;
      return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
    }

    // Build and render one entry in the main display area
    function showEntry(entry, activeIndex) {
      var display = document.getElementById("entry-display");

      // Clear existing content
      while (display.firstChild) {
        display.removeChild(display.firstChild);
      }

      // Build article using only createElement and textContent
      var article = document.createElement("article");
      article.className = "journal-entry";

      // Meta row (date badge)
      var meta = document.createElement("div");
      meta.className = "entry-meta";

      var dateBadge = document.createElement("span");
      dateBadge.className = "entry-date-badge";
      dateBadge.textContent = formatDate(entry.date);
      meta.appendChild(dateBadge);

      // Title
      var title = document.createElement("h2");
      title.className = "entry-title";
      title.textContent = entry.title || "";

      // Divider
      var divider = document.createElement("hr");
      divider.className = "entry-divider";

      // Body -- split on double newlines, then single newlines
      var bodyDiv = document.createElement("div");
      bodyDiv.className = "entry-body";

      var rawBody = entry.body || "";
      var paragraphs = rawBody.split(/\n\n+/);
      if (paragraphs.length === 1) {
        paragraphs = rawBody.split("\n");
      }
      paragraphs.forEach(function(chunk) {
        var trimmed = chunk.trim();
        if (!trimmed) return;
        var p = document.createElement("p");
        p.textContent = trimmed;
        bodyDiv.appendChild(p);
      });
      if (bodyDiv.children.length === 0 && rawBody.trim()) {
        var p = document.createElement("p");
        p.textContent = rawBody.trim();
        bodyDiv.appendChild(p);
      }

      article.appendChild(meta);
      article.appendChild(title);
      article.appendChild(divider);
      article.appendChild(bodyDiv);
      display.appendChild(article);

      // Update active state on sidebar buttons
      var sidebarBtns = document.querySelectorAll(".sidebar-item-btn");
      sidebarBtns.forEach(function(btn, i) {
        btn.classList.toggle("active", i === activeIndex);
      });

      // Update active state on mobile buttons
      var mobileBtns = document.querySelectorAll(".mobile-entry-btn");
      mobileBtns.forEach(function(btn, i) {
        btn.classList.toggle("active", i === activeIndex);
      });
    }

    // Build one sidebar button item
    function buildSidebarItem(entry, index) {
      var li = document.createElement("li");
      var btn = document.createElement("button");
      btn.className = "sidebar-item-btn";
      btn.type = "button";

      var dateSpan = document.createElement("span");
      dateSpan.className = "sidebar-item-date";
      dateSpan.textContent = formatDate(entry.date);

      var titleSpan = document.createElement("span");
      titleSpan.className = "sidebar-item-title";
      titleSpan.textContent = entry.title || "";

      btn.appendChild(dateSpan);
      btn.appendChild(titleSpan);
      li.appendChild(btn);

      btn.addEventListener("click", function() {
        showEntry(entry, index);
      });

      return li;
    }

    // Build one mobile list button item
    function buildMobileItem(entry, index) {
      var li = document.createElement("li");
      var btn = document.createElement("button");
      btn.className = "mobile-entry-btn";
      btn.type = "button";

      var dateSpan = document.createElement("span");
      dateSpan.className = "mobile-entry-date";
      dateSpan.textContent = formatDate(entry.date);

      var titleSpan = document.createElement("span");
      titleSpan.className = "mobile-entry-title";
      titleSpan.textContent = entry.title || "";

      btn.appendChild(dateSpan);
      btn.appendChild(titleSpan);
      li.appendChild(btn);

      btn.addEventListener("click", function() {
        showEntry(entry, index);
        // Close the mobile list after selection
        var list = document.getElementById("mobile-entry-list");
        var toggleBtn = document.getElementById("mobile-toggle-btn");
        list.classList.remove("open");
        toggleBtn.setAttribute("aria-expanded", "false");
        list.setAttribute("aria-hidden", "true");
      });

      return li;
    }

    // Main fetch and render
    async function loadJournal() {
      var statusEl = document.getElementById("journal-status");
      var sidebarList = document.getElementById("sidebar-list");
      var mobileList = document.getElementById("mobile-entry-list");

      try {
        var response = await fetch(API_URL);
        if (!response.ok) throw new Error("API returned " + response.status);
        var entries = await response.json();

        // Remove loading message
        if (statusEl) statusEl.remove();

        if (!Array.isArray(entries) || entries.length === 0) {
          var display = document.getElementById("entry-display");
          var msg = document.createElement("p");
          msg.className = "journal-status";
          msg.textContent = "Norbert's journal entries are on the way. Check back soon.";
          display.appendChild(msg);
          return;
        }

        allEntries = entries;

        // Build sidebar and mobile nav lists
        entries.forEach(function(entry, index) {
          sidebarList.appendChild(buildSidebarItem(entry, index));
          mobileList.appendChild(buildMobileItem(entry, index));
        });

        // Show newest entry by default
        showEntry(entries[0], 0);

      } catch (err) {
        if (statusEl) {
          statusEl.textContent = "The forest is quiet right now. Please try again in a moment.";
        }
        console.error("Journal fetch error:", err);
      }
    }

    // Mobile toggle button handler
    document.addEventListener("DOMContentLoaded", function() {
      loadJournal();

      var toggleBtn = document.getElementById("mobile-toggle-btn");
      var mobileList = document.getElementById("mobile-entry-list");

      toggleBtn.addEventListener("click", function() {
        var isOpen = mobileList.classList.contains("open");
        mobileList.classList.toggle("open", !isOpen);
        toggleBtn.setAttribute("aria-expanded", String(!isOpen));
        mobileList.setAttribute("aria-hidden", String(isOpen));
      });
    });
  </script>

</body>
</html>
